# test value or an empty secret for production.
DJANGO_ENV=development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=doctor_portal
POSTGRES_USER=doctor_portal
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Real-provider adapter/onboarding is pending. Empty configuration must fail
# closed; there is no console/fake delivery fallback.
PATIENT_OTP_PROVIDER=
